# Why People Follow — Apache configuration
Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and www (uncomment once SSL is active)
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.whypeoplefollow.com%{REQUEST_URI} [L,R=301]

# Block direct access to internals
RewriteRule ^(includes|content|data)/ - [F,L]

# Redirect /page.php to /page (clean URLs)
RewriteCond %{THE_REQUEST} \s/([a-z0-9-]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Articles: /resources/my-article
RewriteRule ^resources/([a-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]

# Sitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# /page -> page.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
